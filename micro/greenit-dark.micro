# Greenit dark — micro color scheme
# Install: cp micro/greenit-dark.micro ~/.config/micro/colorschemes/
# Then in micro: set colorscheme greenit-dark

color-link default "#C9E4CE,#0C1F17"
color-link comment "#78997F"
color-link identifier "#7BD88F"
color-link constant "#63C9A8"
color-link constant.string "#B8CC7A"
color-link statement "bold #7FD7C4"
color-link symbol "#C9E4CE"
color-link symbol.operator "#B8CC7A"
color-link preproc "#A88EA0"
color-link type "#7FD7C4"
color-link special "#63C9A8"
color-link underlined "#A88EA0"
color-link error "bold #C07A6E"
color-link todo "bold #A88EA0"
color-link selection "#C9E4CE,#122A1F"
color-link statusline "#C9E4CE,#122A1F"
color-link statusline.inactive "#78997F,#0C1F17"
color-link statusline.suggestions "#C9E4CE,#122A1F"
color-link tabbar "#C9E4CE,#122A1F"
color-link tabbar.active "#0C1F17,#7BD88F"
color-link indent-char "#78997F"
color-link line-number "#78997F"
color-link current-line-number "#7BD88F"
color-link gutter-info "#7FD7C4"
color-link gutter-error "#C07A6E"
color-link gutter-warning "#B8CC7A"
color-link diff-added "#7BD88F"
color-link diff-modified "#B8CC7A"
color-link diff-deleted "#C07A6E"
color-link cursor-line "#122A1F"
color-link color-column "#122A1F"
color-link message "#63C9A8"
color-link error-message "#C07A6E"
color-link match-brace "#7BD88F"
color-link hlsearch "#B8CC7A,#122A1F"
color-link tab-error "#C07A6E"
color-link trailingws "#C07A6E"
color-link ignore "default"
color-link type.extended "default"
