# Greenit dark — Powerlevel10k prompt theme
# Source: source "$HOME/repos/Greenit/powerlevel10k/greenit-dark.zsh"
# in ~/.p10k.zsh, or add to ~/.zshrc after p10k is loaded.
# Hex #RRGGBB values are supported by Powerlevel10k.

typeset -g POWERLEVEL9K_BACKGROUND=
typeset -g POWERLEVEL9K_FOREGROUND="#C9E4CE"

# Context (user@hostname)
typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND="#C9E4CE"
typeset -g POWERLEVEL9K_CONTEXT_BACKGROUND="#122A1F"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_BACKGROUND="#122A1F"

# Directory
typeset -g POWERLEVEL9K_DIR_FOREGROUND="#C9E4CE"
typeset -g POWERLEVEL9K_DIR_BACKGROUND="#0C1F17"
typeset -g POWERLEVEL9K_DIR_HOME_FOREGROUND="#C9E4CE"
typeset -g POWERLEVEL9K_DIR_HOME_BACKGROUND="#0C1F17"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND="#C9E4CE"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_BACKGROUND="#0C1F17"
typeset -g POWERLEVEL9K_DIR_ETC_FOREGROUND="#63C9A8"
typeset -g POWERLEVEL9K_DIR_ETC_BACKGROUND="#0C1F17"

# VCS (git)
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND="#7BD88F"
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND="#0C1F17"
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND="#B8CC7A"
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND="#0C1F17"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND="#63C9A8"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND="#0C1F17"
typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND="#78997F"
typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND="#0C1F17"

# Status (exit code)
typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND="#7BD88F"
typeset -g POWERLEVEL9K_STATUS_OK_BACKGROUND="#0C1F17"
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_STATUS_ERROR_BACKGROUND="#0C1F17"

# Prompt char
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#7BD88F"
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=

# Time
typeset -g POWERLEVEL9K_TIME_FOREGROUND="#78997F"
typeset -g POWERLEVEL9K_TIME_BACKGROUND="#0C1F17"

# Command execution time
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND="#63C9A8"
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND="#0C1F17"

# Background jobs
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND="#A88EA0"
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_BACKGROUND="#0C1F17"

# Root indicator
typeset -g POWERLEVEL9K_ROOT_INDICATOR_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_ROOT_INDICATOR_BACKGROUND="#0C1F17"

# Dir writable
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_BACKGROUND="#0C1F17"

# Separators
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR='\uE0B0'
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR='\uE0B2'
typeset -g POWERLEVEL9K_LEFT_SUBSEGMENT_SEPARATOR='\uE0B1'
typeset -g POWERLEVEL9K_RIGHT_SUBSEGMENT_SEPARATOR='\uE0B3'
