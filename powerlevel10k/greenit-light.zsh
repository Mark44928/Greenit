# Greenit light — Powerlevel10k prompt theme
# Source: source "$HOME/repos/Greenit/powerlevel10k/greenit-light.zsh"
# in ~/.p10k.zsh, or add to ~/.zshrc after p10k is loaded.
# Hex #RRGGBB values are supported by Powerlevel10k.

typeset -g POWERLEVEL9K_BACKGROUND=
typeset -g POWERLEVEL9K_FOREGROUND="#24382C"

# Context (user@hostname)
typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND="#24382C"
typeset -g POWERLEVEL9K_CONTEXT_BACKGROUND="#E6EFE2"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_BACKGROUND="#E6EFE2"

# Directory
typeset -g POWERLEVEL9K_DIR_FOREGROUND="#24382C"
typeset -g POWERLEVEL9K_DIR_BACKGROUND="#F2F7EF"
typeset -g POWERLEVEL9K_DIR_HOME_FOREGROUND="#24382C"
typeset -g POWERLEVEL9K_DIR_HOME_BACKGROUND="#F2F7EF"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND="#24382C"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_BACKGROUND="#F2F7EF"
typeset -g POWERLEVEL9K_DIR_ETC_FOREGROUND="#63C9A8"
typeset -g POWERLEVEL9K_DIR_ETC_BACKGROUND="#F2F7EF"

# VCS (git)
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND="#7BD88F"
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND="#F2F7EF"
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND="#B8CC7A"
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND="#F2F7EF"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND="#63C9A8"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND="#F2F7EF"
typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND="#56695C"
typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND="#F2F7EF"

# Status (exit code)
typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND="#7BD88F"
typeset -g POWERLEVEL9K_STATUS_OK_BACKGROUND="#F2F7EF"
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_STATUS_ERROR_BACKGROUND="#F2F7EF"

# Prompt char
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#7BD88F"
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=

# Time
typeset -g POWERLEVEL9K_TIME_FOREGROUND="#56695C"
typeset -g POWERLEVEL9K_TIME_BACKGROUND="#F2F7EF"

# Command execution time
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND="#63C9A8"
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND="#F2F7EF"

# Background jobs
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND="#A88EA0"
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_BACKGROUND="#F2F7EF"

# Root indicator
typeset -g POWERLEVEL9K_ROOT_INDICATOR_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_ROOT_INDICATOR_BACKGROUND="#F2F7EF"

# Dir writable
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_FOREGROUND="#C07A6E"
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_BACKGROUND="#F2F7EF"

# Separators
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR='\uE0B0'
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR='\uE0B2'
typeset -g POWERLEVEL9K_LEFT_SUBSEGMENT_SEPARATOR='\uE0B1'
typeset -g POWERLEVEL9K_RIGHT_SUBSEGMENT_SEPARATOR='\uE0B3'
