# Greenit dark — nano nanorc theme
# Install: cp nano/greenit-dark.nanorc ~/.config/nano/nanorc
# or: echo "include ~/.config/nano/nanorc" >> ~/.nanorc
# Colors use nano's 3-digit hex #RGB form (high nibble of each channel).

set titlecolor bold,#7D8,#0C1F17
set keycolor bold,#6CA,#0C1F17
set selectedcolor #CEC,#7D8
set statuscolor #CEC,#121
set errorcolor bold,#C76,#0C1F17
set functioncolor #7DC,#0C1F17
set numbercolor #BC7,#0C1F17
set stripecolor #797,#0C1F17
set scrollercolor #797,#0C1F17
set promptcolor #7D8,#0C1F17
set minicolor #CEC,#0C1F17
set spotcolor #6CA,#0C1F17
set icolor #BC7,#0C1F17

# Basic syntax highlighting — mirrors the vim recipe
syntax "greenit" "\.(c|h|py|sh|js|ts|lua|rs|go|vim|toml|yaml|yml|json|md|txt|conf)$"

# Comments
color #797,normal "^\s*#.*$"
color #797,normal "//.*$"
color #797,normal "/\*.*\*/"

# Strings
color #7D8,normal "\"[^\"]*\""
color #7D8,normal "'[^']*'"

# Keywords
color #A8A,normal "\<(if|then|else|elif|fi|do|done|case|esac|for|while|until|function|return|break|continue)\>"
color #A8A,normal "\<(if|elif|else|for|while|def|class|return|break|continue|import|from|as|with|try|except|finally|lambda|yield|async|await)\>"

# Types/builtins
color #7DC,normal "\<(int|float|str|bool|list|dict|tuple|set|None|True|False|print|len|open|range|print)\>"
color #7DC,normal "\<(string|integer|number|boolean|array|object|null|true|false|null)\>"

# Numbers
color #7DC,normal "[0-9]+"

# Operators/punctuation
color #BC7,normal "\(\)\{\}\[\]"
color #BC7,normal "[=+\-*/%!<>&|^~,.;:]"

# Filenames/paths
color #6CA,normal "\b[A-Za-z_][A-Za-z0-9_]*\.[a-zA-Z0-9_]+\b"

include "/usr/share/nano/*.nanorc"
