# Greenit light — ripgrep color configuration
# Install: cp ripgrep/greenit-light.rc ~/.ripgreprc
# Then: export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
# Uses 24-bit truecolor hex values (#RRGGBB).

--colors=match:fg:123,216,143
--colors=match:style:bold
--colors=path:fg:99,201,168
--colors=path:style:bold
--colors=line:fg:86,105,92
--colors=column:fg:127,215,196
--colors=highlight:bg:184,204,122
--colors=highlight:fg:242,247,239
