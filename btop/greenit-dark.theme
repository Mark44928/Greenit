# Greenit dark — btop theme
# Install: cp btop/greenit-dark.theme ~/.config/btop/themes/
# and set color_theme = "greenit-dark" in btop.conf

theme[main_bg]="#0C1F17"
theme[main_fg]="#C9E4CE"
theme[title]="#C9E4CE"
theme[hi_fg]="#7BD88F"
theme[selected_bg]="#7BD88F"
