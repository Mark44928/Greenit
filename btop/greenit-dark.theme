theme[inactive_fg]="#78997F"
theme[graph_text]="#C9E4CE"
theme[meter_bg]="#122A1F"
theme[proc_misc]="#63C9A8"
theme[cpu_box]="#78997F"
theme[mem_box]="#7FD7C4"
