# Greenit ${variant} — dircolors (LS_COLORS) theme
# eval "$(dircolors -b dircolors/greenit-${variant})"
# dircolors expresses colors as ANSI codes only, so this theme maps file
# classes to the palette's ANSI slots (color0..color15) as rendered by the
# terminal. Install the file matching your terminal variant.

TERM linux
TERM linux-c
TERM mach-color
TERM console
TERM cons25
TERM color-xterm
TERM rxvt
TERM rxvt-color
TERM xterm
TERM xterm-color
TERM *color*
TERM cygwin

NORMAL 00
FILE 00
RESET 00
DIR 01;34
LINK 01;36
MULTIHARDLINK 00
FORK 00
EXEC 01;32
FIFO 40;33;01
SOCK 01;35
DOOR 01;35
BLK 01;34
CHR 01;34
ORPHAN 01;05;37;41
MISSING 01;05;37;41
ORPHAN 40;31;01

