# Greenit ${variant} — micro color scheme
# Install: cp micro/greenit-${variant}.micro ~/.config/micro/colorschemes/
# Then in micro: set colorscheme greenit-${variant}

color-link default "${P.editor.fg},${P.editor.bg}"
color-link comment "${P.editor.comment}"
color-link identifier "${P.accents.primary}"
color-link constant "${P.accents.secondary}"
color-link constant.string "${P.accents.yellow}"
color-link statement "bold ${P.accents.cyan}"
color-link symbol "${P.editor.fg}"
color-link symbol.operator "${P.accents.yellow}"
color-link preproc "${P.accents.rose}"
color-link type "${P.accents.cyan}"
color-link special "${P.accents.secondary}"
color-link underlined "${P.accents.rose}"
color-link error "bold ${P.accents.error}"
color-link todo "bold ${P.accents.rose}"
color-link selection "${P.terminal.selection_foreground},${P.terminal.selection_background}"
color-link statusline "${P.terminal.foreground},${P.editor.surface}"
color-link statusline.inactive "${P.editor.comment},${P.editor.bg}"
color-link statusline.suggestions "${P.terminal.foreground},${P.editor.surface}"
color-link tabbar "${P.terminal.foreground},${P.editor.surface}"
color-link tabbar.active "${P.terminal.background},${P.accents.primary}"
color-link indent-char "${P.editor.comment}"
color-link line-number "${P.editor.comment}"
color-link current-line-number "${P.accents.primary}"
color-link gutter-info "${P.accents.cyan}"
color-link gutter-error "${P.accents.error}"
color-link gutter-warning "${P.accents.yellow}"
color-link diff-added "${P.accents.primary}"
color-link diff-modified "${P.accents.yellow}"
color-link diff-deleted "${P.accents.error}"
color-link cursor-line "${P.editor.surface}"
color-link color-column "${P.editor.surface}"
color-link message "${P.accents.secondary}"
color-link error-message "${P.accents.error}"
color-link match-brace "${P.accents.primary}"
color-link hlsearch "${P.accents.yellow},${P.editor.surface}"
color-link tab-error "${P.accents.error}"
color-link trailingws "${P.accents.error}"
color-link ignore "default"
color-link type.extended "default"
