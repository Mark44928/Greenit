# Greenit ${variant} — foot terminal theme
# foot reads themes from ~/.config/foot/foot.ini. Drop this file in as
# foot.ini (or include it with `include=~/.config/foot/greenit-${variant}.ini`).
# Colors are hex without the leading '#' (INI has no comments mid-value).
[colors]
background=${nohash:P.terminal.background}
foreground=${nohash:P.terminal.foreground}
cursor=${nohash:P.terminal.cursor}
selection-background=${nohash:P.terminal.selection_background}
selection-foreground=${nohash:P.terminal.selection_foreground}

regular0=${nohash:P.ansi[0]}
regular1=${nohash:P.ansi[1]}
regular2=${nohash:P.ansi[2]}
regular3=${nohash:P.ansi[3]}
regular4=${nohash:P.ansi[4]}
regular5=${nohash:P.ansi[5]}
regular6=${nohash:P.ansi[6]}
regular7=${nohash:P.ansi[7]}
bright0=${nohash:P.ansi[8]}
bright1=${nohash:P.ansi[9]}
bright2=${nohash:P.ansi[10]}
bright3=${nohash:P.ansi[11]}
bright4=${nohash:P.ansi[12]}
bright5=${nohash:P.ansi[13]}
bright6=${nohash:P.ansi[14]}
bright7=${nohash:P.ansi[15]}
