# Greenit ${variant} — lazygit theme
# Install: cp lazygit/greenit-${variant}.yml ~/.config/lazygit/greenit-${variant}.yml
# Load: lazygit --use-config-file ~/.config/lazygit/config.yml,~/.config/lazygit/greenit-${variant}.yml
# Or: LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/greenit-${variant}.yml" lazygit

gui:
  theme:
    activeBorderColor:
      - "${P.accents.primary}"
      - bold
    inactiveBorderColor:
      - "${P.editor.comment}"
    searchingActiveBorderColor:
      - "${P.accents.secondary}"
    optionsTextColor:
      - "${P.accents.primary}"
    selectedLineBgColor:
      - "${P.editor.surface}"
    inactiveViewSelectedLineBgColor:
      - "${P.editor.surface}"
    cherryPickedCommitFgColor:
      - "${P.accents.primary}"
    cherryPickedCommitBgColor:
      - "${P.editor.surface}"
    markedBaseCommitFgColor:
      - "${P.accents.primary}"
    markedBaseCommitBgColor:
      - "${P.accents.yellow}"
    unstagedChangesColor:
      - "${P.accents.error}"
    defaultFgColor:
      - "${P.editor.fg}"
    selectedLineFgColor:
      - "${P.editor.fg}"

  colorScheme: {{#if variant == "dark"}}dark{{/if}}{{#if variant == "light"}}light{{/if}}
