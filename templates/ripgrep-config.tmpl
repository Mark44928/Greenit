# Greenit ${variant} — ripgrep color configuration
# Install: cp ripgrep/greenit-${variant}.rc ~/.ripgreprc
# Then: export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
# Uses 24-bit truecolor hex values (#RRGGBB).

--colors=match:fg:${P.accents.primary}
--colors=match:style:bold
--colors=path:fg:${P.accents.secondary}
--colors=path:style:bold
--colors=line:fg:${P.editor.comment}
--colors=column:fg:${P.accents.cyan}
--colors=highlight:bg:${P.accents.yellow}
--colors=highlight:fg:${P.editor.bg}
