# Greenit Dark — green-injected terminal theme
# Install: cp extras/kitty.conf ~/.config/kitty/greenit.conf && edit kitty.conf to include it

foreground    ${P.terminal.foreground}
background    ${P.terminal.background}
cursor        ${P.terminal.cursor}
cursor_text_color ${P.terminal.cursor_text}
selection_background  ${P.terminal.selection_background}
selection_foreground  ${P.terminal.selection_foreground}
url_color     ${P.terminal.url_color}

# ANSI 16-color table (greens injected)
color0  ${P.ansi[0]}
color1  ${P.ansi[1]}
color2  ${P.ansi[2]}
color3  ${P.ansi[3]}
color4  ${P.ansi[4]}
color5  ${P.ansi[5]}
color6  ${P.ansi[6]}
color7  ${P.ansi[7]}
color8  ${P.ansi[8]}
color9  ${P.ansi[9]}
color10 ${P.ansi[10]}
color11 ${P.ansi[11]}
color12 ${P.ansi[12]}
color13 ${P.ansi[13]}
color14 ${P.ansi[14]}
color15 ${P.ansi[15]}
