;;; greenit-theme.el --- Greenit green-injected Emacs theme -*- lexical-binding: t -*-
;;; Recipe: energreen, slightly greener — every neutral hue-shifted toward
;;; green, every accent a green derivative.

(deftheme greenit
  "Greenit: a green-injected theme family — {{variant}} variant.
Every neutral is hue-shifted toward green; every accent is a green derivative."
  :family 'greenit
  :kind 'color-scheme
  :background-mode '{{variant}})

(custom-theme-set-faces
 'greenit
 ;; UI
 '(default ((t (:foreground "${P.editor.fg}" :background "${P.editor.bg}"))))
 '(cursor ((t (:background "${P.accents.primary}" :foreground "${P.editor.bg}"))))
 '(region ((t (:background "${P.accents.primary}" :foreground "${P.editor.bg}"))))
 '(hl-line ((t (:background "${P.editor.surface}"))))
 '(fringe ((t (:background "${P.editor.bg}"))))
 '(mode-line ((t (:foreground "${P.editor.fg}" :background "${P.editor.surface}" :bold t))))
 '(mode-line-inactive ((t (:foreground "${P.editor.comment}" :background "${P.editor.bg}"))))
 '(mode-line-buffer-id ((t (:bold t :foreground "${P.accents.primary}" :background "${P.editor.surface}"))))
 '(mode-line-highlight ((t (:foreground "${P.accents.yellow}" :background "${P.editor.surface}" :weight bold))))
 '(minibuffer-prompt ((t (:bold t :foreground "${P.accents.rose}"))))

 ;; Syntax — mirrors colors/greenit.vim
 '(font-lock-comment-face ((t (:foreground "${P.editor.comment}" :slant italic))))
 '(font-lock-keyword-face ((t (:foreground "${P.accents.rose}" :weight bold))))
 '(font-lock-function-name-face ((t (:foreground "${P.accents.secondary}" :weight bold))))
 '(font-lock-string-face ((t (:foreground "${P.accents.primary}"))))
 '(font-lock-variable-name-face ((t (:foreground "${P.editor.fg}"))))
 '(font-lock-type-face ((t (:foreground "${P.accents.cyan}"))))
 '(font-lock-constant-face ((t (:foreground "${P.accents.rose}"))))
 '(font-lock-builtin-face ((t (:foreground "${P.editor.fg}"))))
 '(font-lock-preprocessor-face ((t (:foreground "${P.accents.rose}"))))
 '(font-lock-warning-face ((t (:foreground "${P.accents.error}"))))
 '(font-lock-number-face ((t (:foreground "${P.accents.cyan}"))))
 '(font-lock-operator-face ((t (:foreground "${P.accents.yellow}"))))

 ;; Diff / org / misc
 '(diff-added ((t (:foreground "${P.accents.primary}" :background "${P.editor.surface}"))))
 '(diff-removed ((t (:foreground "${P.accents.error}" :background "${P.editor.surface}"))))
 '(diff-changed ((t (:foreground "${P.accents.yellow}" :background "${P.editor.surface}"))))
 '(org-code ((t (:foreground "${P.accents.primary}"))))
 '(org-link ((t (:foreground "${P.accents.cyan}" :underline t))))
 '(org-todo ((t (:weight bold :foreground "${P.accents.rose}"))))

 ;; Highlights
 '(highlight ((t (:foreground "${P.editor.fg}" :background "${P.accents.yellow}"))))
 '(link ((t (:foreground "${P.accents.cyan}" :underline t))))
 '(error ((t (:foreground "${P.accents.error}" :weight bold))))
 '(warning ((t (:foreground "${P.accents.yellow}"))))

 ;; Completion / UI extras
 '(company-preview ((t (:background "${P.editor.surface}" :foreground "${P.editor.fg}"))))
 '(company-tooltip ((t (:foreground "${P.editor.fg}" :background "${P.editor.surface}" :bold t))))
 '(magit-section-heading ((t (:foreground "${P.accents.primary}" :weight bold))))
 '(magit-item-highlight ((t (:background "${P.editor.surface}"))))))

(provide-theme 'greenit)
;;; greenit-theme.el ends here
