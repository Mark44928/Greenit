# Greenit Dark — green-injected terminal theme
# Install: append to ~/.config/ghostty/config or set in config:
#   include = ~/repos/Greenit/extras/ghostty

background = ${P.terminal.background}
foreground = ${P.terminal.foreground}
cursor = ${P.terminal.cursor}
cursor_text = ${P.terminal.cursor_text}

palette = 0=${P.ansi[0]}
palette = 1=${P.ansi[1]}
palette = 2=${P.ansi[2]}
palette = 3=${P.ansi[3]}
palette = 4=${P.ansi[4]}
palette = 5=${P.ansi[5]}
palette = 6=${P.ansi[6]}
palette = 7=${P.ansi[7]}
palette = 8=${P.ansi[8]}
palette = 9=${P.ansi[9]}
palette = 10=${P.ansi[10]}
palette = 11=${P.ansi[11]}
palette = 12=${P.ansi[12]}
palette = 13=${P.ansi[13]}
palette = 14=${P.ansi[14]}
palette = 15=${P.ansi[15]}
