# Greenit dark — git-delta color theme
# Include: [include] path = "$HOME/repos/Greenit/delta/greenit-dark.config"
# in ~/.gitconfig, then activate:
#   [delta] features = greenit-dark
#
# Styles use git config color syntax: [attributes] foreground [background]
# or just "#RRGGBB" for foreground only. See git-config(1) color section.

[delta]
    dark = true
    light = false
    navigate = true
    line-numbers = true
    syntax-theme = Greenit

[delta]
    commit-style = "#A88EA0 bold"
    file-style = "#78997F bold"
    file-decoration-style = "#78997F" overline
    file-added-label = "[+]"
    file-modified-label = "[~]"
    file-removed-label = "[-]"
    file-renamed-label = "[→]"
    hunk-header-style = "#63C9A8 bold italic"
    minus-style = "#C07A6E"
    minus-emph-style = "#C07A6E" bold
    plus-style = "#7BD88F"
    plus-emph-style = "#7BD88F" bold
    zero-style = "#78997F"
    whitespace-error-style = "#C07A6E" reverse
    syntax-theme = Greenit
