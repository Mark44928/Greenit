# Greenit light — git color configuration
# Include: [include] path = "$HOME/repos/Greenit/git/greenit-light.config"
# in ~/.gitconfig, or append these sections directly.
# Hex #RRGGBB values supported by git ≥ 2.26.

[color]
    ui = always
    diff = always
    status = always
    branch = always
    grep = always
    decorate = always
    interactive = always
    pager = true

[color "diff"]
    meta = "#63C9A8 bold"
    frag = "#A88EA0 bold"
    func = "#7FD7C4"
    context = "#56695C"
    old = "#C07A6E bold"
    new = "#7BD88F bold"
    commit = "#B8CC7A"
    whitespace = "#C07A6E reverse"

[color "status"]
    header = "#24382C bold"
    added = "#7BD88F"
    changed = "#B8CC7A"
    untracked = "#A88EA0"
    branch = "#63C9A8 bold"
    nobranch = "#C07A6E reverse"

[color "branch"]
    current = "#7BD88F bold"
    local = "#24382C"
    remote = "#63C9A8"
    upstream = "#A88EA0"
    plain = "#24382C"

[color "decorate"]
    branch = "#7FD7C4"
    remoteBranch = "#63C9A8"
    tag = "#A88EA0"
    stash = "#B8CC7A"
    HEAD = "#56695C"

[color "grep"]
    filename = "#A88EA0"
    linenumber = "#63C9A8"
    match = "#7BD88F bold"
    matchContext = "#24382C"
    separator = "#56695C"

[color "interactive"]
    prompt = "#7BD88F bold"
    header = "#24382C"
    help = "#56695C"
    error = "#C07A6E"
